{
  "manifest_version": 3,
  "name": "StyleSniper",
  "short_name": "StyleSniper",
  "version": "1.0.0",
  "description": "Precision CSS-to-Tailwind X-Ray inspector, Figma-style redline measurements, WCAG 2.1 contrast checker, live text editor, and SVG gobbler.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "StyleSniper — X-Ray Inspector (Alt+Shift+X)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open StyleSniper popup"
    },
    "toggle-xray": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Toggle StyleSniper X-Ray Inspector"
    }
  }
}
